# vLLM v0.33.0rc3 /metrics as its Prometheus logger writes it: names, help
# and labels from vllm/v1/metrics/loggers.py, vllm/v1/spec_decode/metrics.py
# and vllm/config/cache.py (CacheConfig.metrics_info) at that tag. One engine
# serves Qwen/Qwen3-8B with a three-token draft and an fp8 KV cache.
# HELP vllm:num_requests_running Number of requests in model execution batches.
# TYPE vllm:num_requests_running gauge
vllm:num_requests_running{model_name="Qwen/Qwen3-8B",engine="0"} 2.0
# HELP vllm:num_requests_waiting Number of requests waiting to be processed.
# TYPE vllm:num_requests_waiting gauge
vllm:num_requests_waiting{model_name="Qwen/Qwen3-8B",engine="0"} 1.0
# HELP vllm:num_requests_waiting_by_reason Number of requests waiting, by reason.
# TYPE vllm:num_requests_waiting_by_reason gauge
vllm:num_requests_waiting_by_reason{model_name="Qwen/Qwen3-8B",engine="0",reason="capacity"} 1.0
vllm:num_requests_waiting_by_reason{model_name="Qwen/Qwen3-8B",engine="0",reason="deferred"} 0.0
# HELP vllm:engine_sleep_state Engine sleep state; awake = 0 means engine is sleeping; awake = 1 means engine is awake; weights_offloaded = 1 means sleep level 1; discard_all = 1 means sleep level 2.
# TYPE vllm:engine_sleep_state gauge
vllm:engine_sleep_state{model_name="Qwen/Qwen3-8B",engine="0",sleep_state="awake"} 1.0
vllm:engine_sleep_state{model_name="Qwen/Qwen3-8B",engine="0",sleep_state="weights_offloaded"} 0.0
vllm:engine_sleep_state{model_name="Qwen/Qwen3-8B",engine="0",sleep_state="discard_all"} 0.0
